# Liberty Aminos — Storefront Environment Variables
# Copy this file to .env.local and fill in values before running the dev server.
# Never commit .env.local or any file containing real secrets.

# ---------------------------------------------------------------------------
# WooCommerce backend (server-side only — never use NEXT_PUBLIC_ prefix here)
# ---------------------------------------------------------------------------

# Full URL of the WooCommerce installation, e.g. https://db.libertyaminos.com
NEXT_PUBLIC_WC_URL=

# WooCommerce REST API consumer key (generated in WP Admin → WooCommerce → Settings → Advanced → REST API)
# Must be server-side only (read/write permissions)
WC_CONSUMER_KEY=

# WooCommerce REST API consumer secret (server-side only)
WC_CONSUMER_SECRET=

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------

# Canonical site URL, e.g. https://libertyaminos.com (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Live chat (Tawk.to) — optional
# ---------------------------------------------------------------------------

# Tawk.to property ID (from the Tawk.to embed snippet)
NEXT_PUBLIC_TAWK_PROPERTY_ID=

# Tawk.to widget ID (from the Tawk.to embed snippet)
NEXT_PUBLIC_TAWK_WIDGET_ID=

# ---------------------------------------------------------------------------
# Analytics & tag management — optional
# ---------------------------------------------------------------------------

# Google Tag Manager container ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Omnisend email marketing — optional
# ---------------------------------------------------------------------------

# Omnisend brand ID (from the Omnisend embed snippet)
NEXT_PUBLIC_OMNISEND_BRAND_ID=

# ---------------------------------------------------------------------------
# CRM / live chat integration — optional (stub returns false if not set)
# ---------------------------------------------------------------------------

# Internal CRM base URL (no trailing slash)
NEXT_PUBLIC_CRM_URL=

# CRM tracking key for chat widget
NEXT_PUBLIC_CRM_TRACKING_KEY=

# Server-side CRM API URL (used for server actions only)
CRM_API_URL=

# ---------------------------------------------------------------------------
# Google Reviews — optional
# ---------------------------------------------------------------------------

# Google Places API key (server-side only, for fetching live Google reviews)
GOOGLE_PLACES_API_KEY=

# Google Place ID for the Liberty Aminos business listing
GOOGLE_PLACE_ID=

# ---------------------------------------------------------------------------
# Google Inventory / Sheets feed — optional
# ---------------------------------------------------------------------------

GOOGLE_INVENTORY_FEED_URL=
GOOGLE_INVENTORY_SHEET_ID=
GOOGLE_INVENTORY_SHEET_RANGE=
GOOGLE_INVENTORY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_INVENTORY_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Promotions — optional
# ---------------------------------------------------------------------------

# GLP-series promo code to surface on the storefront
NEXT_PUBLIC_GLP_PROMO_CODE=

# Display label for the GLP promo banner
NEXT_PUBLIC_GLP_PROMO_LABEL=

# ---------------------------------------------------------------------------
# Development helpers — optional
# ---------------------------------------------------------------------------

# Set to "true" to use demo (hardcoded) Google reviews instead of live API
DEMO_REVIEWS=
