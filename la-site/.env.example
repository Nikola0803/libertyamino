# Liberty Aminos — Next.js storefront environment variables
# Copy to .env.local for local development. Never commit .env.local.

# WooCommerce backend URL (no trailing slash)
NEXT_PUBLIC_WC_URL=https://db.libertyaminos.com

# WooCommerce REST API credentials (for server-side calls only)
WC_CONSUMER_KEY=ck_...
WC_CONSUMER_SECRET=cs_...

# Site URL
NEXT_PUBLIC_SITE_URL=https://libertyaminos.com

# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# Meta CAPI token (server-side purchase events) — never expose client-side
META_CAPI_TOKEN=

# CRM / email inbox (server-side only)
CRM_INBOX_EMAIL=

# Payment rail webhook secret (server-side only)
PAYMENT_WEBHOOK_SECRET=
